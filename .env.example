# Copy to .env.local (local dev) or set in your host's dashboard (e.g. Vercel).
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- Supabase (Project Settings -> API) -------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key, used server-side for the auth session only.
# Autoblog never sends it to browsers; keep it private anyway (see README: "Confirm email").
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key. Server-side only: full database and storage access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access -------------------------------------------------------------
# Comma-separated emails allowed to sign in to /admin (case-insensitive).
ADMIN_EMAILS=you@example.com

# --- Automation ---------------------------------------------------------------
# Protects GET /api/cron/tick (sent as "Authorization: Bearer <secret>").
# At least 16 characters; generate one with: openssl rand -hex 32
# On Vercel, setting this variable makes Vercel Cron send the header itself.
CRON_SECRET=

# --- AI providers (set at least one) -----------------------------------------
# Only the providers whose key is set can be selected in the admin settings.
# Keys stay in the environment; they are never stored in the database.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Public API -----------------------------------------------------------------
# Comma-separated origins allowed to call /api/posts from a browser,
# e.g. https://www.example.com,https://example.com. Empty or "*" = any origin.
PUBLIC_API_ALLOWED_ORIGINS=
